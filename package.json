{
  "name": "aiyou",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": {
    "name": "光波",
    "email": "a@ggbo.com"
  },
  "license": "MIT",
  "copyright": "Copyright (c) 2025 光波. All rights reserved.",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@tauri-apps/cli"]
  },
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev:backend": "npm --prefix server start",
    "dev:backend:watch": "npm --prefix server run dev",
    "build": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "preview:4000": "vite preview --config frontend/vite.config.ts --host 0.0.0.0 --port 4000",
    "test": "vitest run --config frontend/vitest.config.ts",
    "test:watch": "vitest --config frontend/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config frontend/vitest.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build-server": "node scripts/build-server.js",
    "tauri:build-server:mac:intel": "node scripts/build-server.js x86_64-apple-darwin",
    "tauri:build-server:mac:arm64": "node scripts/build-server.js aarch64-apple-darwin",
    "tauri:build": "pnpm tauri:build-server && tauri build",
    "tauri:build:mac:intel": "pnpm tauri:build-server:mac:intel && tauri build --target x86_64-apple-darwin",
    "tauri:build:mac:arm64": "pnpm tauri:build-server:mac:arm64 && tauri build --target aarch64-apple-darwin"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/genai": "^1.30.0",
    "immer": "^11.1.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swr": "^2.3.8",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@sentry/react": "^10.32.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "docx": "^9.5.1",
    "esbuild": "^0.27.3",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
